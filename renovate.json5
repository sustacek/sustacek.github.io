{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  timezone: 'Europe/Prague',
  rangeStrategy: 'pin',
  minimumReleaseAge: '3 days',
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      'before 6am on monday',
    ],
  },
  dependencyDashboard: {
    enabled: true,
  },
  packageRules: [
    {
      groupName: 'Docusaurus',
      matchPackageNames: [
        '@docusaurus/**',
      ],
    },
    {
      groupName: 'React',
      matchPackageNames: [
        'react',
        'react-dom',
      ],
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      dependencyDashboardApproval: true,
    },
  ],
}
